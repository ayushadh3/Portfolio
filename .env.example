# ── Server-side secrets — set these in Vercel → Project → Settings → Environment Variables ──
# Never place any of these values in client-side code.

# Transactional email (Resend). Create a key at https://resend.com/api-keys
# and verify your sending domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form emails are delivered
CONTACT_TO_EMAIL=hello@aayushadhikari.com.np

# Verified sender identity on your Resend domain
MAIL_FROM="Portfolio Contact <no-reply@aayushadhikari.com.np>"

# Optional Cloudflare Turnstile bot protection.
# Leave empty to rely on honeypot + timing + rate limiting.
# If set, also embed the matching site-key widget in the contact form
# and its response token will be verified server-side.
TURNSTILE_SECRET_KEY=

# Canonical production URL (used in email footers and logs)
SITE_URL=https://aayushadhikari.com.np
